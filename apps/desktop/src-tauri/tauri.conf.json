{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Hecate",
  "version": "1.0.0",
  "identifier": "com.hecate.pkm",
  "build": {
    "frontendDist": "../../../apps/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @hecate/web dev",
    "beforeBuildCommand": "pnpm --filter @hecate/web build"
  },
  "app": {
    "windows": [
      {
        "title": "Hecate",
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": "Dark"
      },
      {
        "label": "quick-capture",
        "title": "Hecate Quick Capture",
        "width": 480,
        "height": 180,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: data: https:;"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "tooltip": "Hecate PKM"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:hecate.db"]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["hecate"]
      }
    }
  }
}
